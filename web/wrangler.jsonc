{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "open-cyber-academy",
  "account_id": "1e04c78c6d0084600ddb4589c4e3327c",
  "main": "api/worker.py",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["python_workers"],
  "workers_dev": true,
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://decripte.cloudflareaccess.com",
    "ACCESS_AUD": "22dfe518f32b7fd41319089fff0a6f28d15596bb690abda2602bf38978194503"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "open-cyber-academy-progress", "database_id": "9838c800-6de4-423a-af03-dd0c3f231452" }
  ],
  "send_email": [
    { "name": "EMAIL", "allowed_sender_addresses": ["login@auth.opencyber.academy"] }
  ],
  "routes": [
    { "pattern": "opencyber.academy", "custom_domain": true },
    { "pattern": "www.opencyber.academy", "custom_domain": true },
    { "pattern": "pt.opencyber.academy", "custom_domain": true },
    { "pattern": "es.opencyber.academy", "custom_domain": true },
    { "pattern": "he.opencyber.academy", "custom_domain": true },
    { "pattern": "fr.opencyber.academy", "custom_domain": true },
    { "pattern": "ru.opencyber.academy", "custom_domain": true },
    { "pattern": "de.opencyber.academy", "custom_domain": true },
    { "pattern": "zh.opencyber.academy", "custom_domain": true },
    { "pattern": "ja.opencyber.academy", "custom_domain": true }
  ]
}
