---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="My area · OpenCyber Academy" description="Use an email code to save your progress. All books remain open." robots="noindex,follow">
  <section class="account-hero"><div class="shell"><div class="eyebrow" data-account="eyebrow">OPTIONAL STUDENT AREA</div><h1 data-account="heading">Your learning, at your pace.</h1><p data-account="intro">Books and lessons are open without an account. Use an email code only to save progress and take chapter tests.</p><a href="/tests/" data-account="tests">Explore chapter tests →</a></div></section>
  <section class="section"><div class="shell account-grid">
    <div class="card profile">
      <div class="eyebrow" data-account="identity">STUDENT ACCOUNT</div>
      <h2 id="profile-title">Checking your session…</h2>
      <p id="profile-description" class="muted">No password is required.</p>
      <form id="email-form" hidden><label for="account-email" data-account="email">Email address</label><input id="account-email" type="email" autocomplete="email" maxlength="254" required /><button class="button gold" type="submit" data-account="send">Send code</button></form>
      <form id="code-form" hidden><label for="account-code" data-account="code">Six-digit code</label><input id="account-code" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required /><button class="button gold" type="submit" data-account="signin">Sign in</button><button class="button secondary" type="button" id="code-back" data-account="back">Use another email</button></form>
      <button class="button secondary" type="button" id="account-logout" hidden data-account="signout">Sign out</button>
      <p id="account-message" class="muted" role="status" aria-live="polite"></p>
    </div>
    <div class="card benefits"><div class="eyebrow" data-account="benefits">YOUR STUDY AREA</div><h2 data-account="benefitsTitle">What you can track</h2><div class="benefit"><span>✓</span><div><strong data-account="lessons">Completed lessons</strong><p data-account="lessonsDetail">Mark a lesson when you finish reading.</p></div></div><div class="benefit"><span>✎</span><div><strong data-account="exercises">Exercise attempts</strong><p data-account="exercisesDetail">Save your answers and continue later.</p></div></div><div class="benefit"><span>◌</span><div><strong data-account="media">Audio and video</strong><p data-account="mediaDetail">Planned for later; reading is already open.</p></div></div></div>
  </div></section>
  <section class="section records"><div class="shell"><div class="eyebrow" data-account="history">MY HISTORY</div><h2 data-account="historyTitle">Saved progress</h2><p id="records-status" class="muted">Sign in to see your lessons and attempts.</p><div id="records-list" class="record-list"></div><a class="button gold" href="/levels/" data-account="continue">Continue learning →</a></div></section>
  <script>
    import { initializeStudentAccount } from '../lib/student-account';
    void initializeStudentAccount();
  </script>
</BaseLayout>
<style is:global>
  .account-hero { padding: 94px 0 72px; background: linear-gradient(110deg, var(--bg-2), var(--bg)); border-bottom: 1px solid var(--line); }.account-hero h1 { font-size: clamp(2.7rem,5vw,5rem); }.account-hero p { color: var(--muted); max-width: 690px; font-size: 1.1rem; }
  .account-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }.account-grid .card { padding: 32px; }.profile { min-height: 340px; }.profile h2,.benefits h2 { font-size: 1.6rem; margin: 12px 0; overflow-wrap: anywhere; }.profile p { max-width: 480px; }.profile .button { margin-top: 15px; }.profile form { display: grid; gap: 12px; max-width: 360px; margin-top: 24px; }.profile form[hidden],.profile button[hidden] { display: none; }.profile input { width: 100%; padding: 12px; border: 1px solid var(--line); border-radius: 4px; background: var(--surface); color: var(--text); font: inherit; }.profile input:focus-visible { outline: 2px solid var(--gold); }.profile #account-logout { margin-top: 18px; }.benefit { display: flex; gap: 14px; border-top: 1px solid var(--line); padding-top: 15px; margin-top: 15px; }.benefit>span { color: var(--gold); font-weight: 600; }.benefit strong { font-size: .95rem; }.benefit p { color: var(--muted); font-size: .84rem; margin: 3px 0 0; }
  .records { background: var(--bg-2); border-top: 1px solid var(--line); }.records h2 { margin-top: 12px; }.record-list { display: grid; grid-template-columns: repeat(2,1fr); gap: 10px; margin: 22px 0 34px; }.record { display: grid; gap: 4px; padding: 16px 18px; background: var(--surface); border: 1px solid var(--line); border-radius: 4px; }.record strong { text-transform: capitalize; }.record span { color: var(--muted); font-size: .8rem; }
  @media(max-width:760px){.account-grid,.record-list{grid-template-columns:1fr}.account-hero{padding:65px 0}.account-grid .card{padding:24px}}
</style>
