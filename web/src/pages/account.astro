---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Sign in or view your progress · OpenCyber Academy" description="Sign in to save your learning progress and take chapter tests. All books and lessons remain open." robots="noindex,follow">
  <section class="account-hero"><div class="shell account-grid">
    <div class="account-intro"><div class="eyebrow" data-account="eyebrow">STUDENT AREA</div><h1 data-account="heading">Your learning, at your pace.</h1><p data-account="intro">Every book and lesson is free to read. Sign in to save your progress and take chapter tests.</p><a href="/tests/" data-account="tests">Explore chapter tests →</a></div>
    <div class="card profile">
      <div class="profile-brand"><img src="/favicon.svg" alt="" width="46" height="46" /><span>OpenCyber Academy</span></div>
      <div class="eyebrow" data-account="identity">STUDENT ACCOUNT</div>
      <h2 id="profile-title">Checking your session…</h2>
      <p id="profile-description" class="muted">Sign in with an email code or your student credentials.</p>
      <p id="return-after-signin" class="return-after-signin" hidden></p>
      <form id="email-form" hidden><label for="account-email" data-account="email">Email address</label><input id="account-email" type="email" autocomplete="email" maxlength="254" required /><button class="button gold" type="submit" data-account="send">Send code</button></form>
      <form id="code-form" hidden><label for="account-code" data-account="code">Six-digit code</label><input id="account-code" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required /><button class="button gold" type="submit" data-account="signin">Sign in</button><button class="button secondary" type="button" id="code-back" data-account="back">Use another email</button></form>
      <form id="password-form" hidden><label for="account-username" data-account="username">Username</label><input id="account-username" type="text" autocomplete="username" pattern="[a-z][a-z0-9_-]{2,39}" maxlength="40" required /><label for="account-password" data-account="password">Password</label><input id="account-password" type="password" autocomplete="current-password" maxlength="256" required /><button class="button gold" type="submit" data-account="signin">Sign in</button></form>
      <button class="button secondary" type="button" id="method-toggle" hidden data-account="passwordMethod">Use username and password</button>
      <button class="button secondary" type="button" id="account-logout" hidden data-account="signout">Sign out</button>
      <p id="account-message" class="muted" role="status" aria-live="polite"></p>
    </div>
  </div></section>
  <section class="section account-benefits"><div class="shell"><div class="card benefits"><div class="eyebrow" data-account="benefits">YOUR STUDY AREA</div><h2 data-account="benefitsTitle">What you can track</h2><div class="benefit"><span>✓</span><div><strong data-account="lessons">Completed lessons</strong><p data-account="lessonsDetail">Mark a lesson when you finish reading.</p></div></div><div class="benefit"><span>✎</span><div><strong data-account="exercises">Exercise attempts</strong><p data-account="exercisesDetail">Save your answers and continue later.</p></div></div><div class="benefit"><span>◌</span><div><strong data-account="media">Audio and video</strong><p data-account="mediaDetail">Planned for later; reading is already open.</p></div></div></div></div></section>
  <section class="section records" id="account-dashboard" hidden><div class="shell">
    <div class="eyebrow" data-account="history">MY HISTORY</div><h1 data-account="dashboardTitle">Your study dashboard</h1>
    <p id="records-status" class="muted" role="status">Sign in to see your lessons and attempts.</p>
    <nav class="account-jump" aria-label="Dashboard sections"><a href="#account-recent" data-account="recentTitle">Recent activity</a><a href="#account-lessons" data-account="savedLessonsTitle">Latest lessons</a><a href="#account-exercises" data-account="savedExercisesTitle">Exercise answers</a><a href="#account-analyses" data-account="analysesTitle">Saved analyses</a><a href="#account-course-section" data-account="performanceTitle">Performance by course</a><a href="#connect-ai" data-account="connectAi">Connect your AI</a></nav>
    <div id="account-metrics" class="metric-grid" aria-label="Study totals"></div>
    <div class="dashboard-grid">
      <section class="card dashboard-panel" id="account-recent"><h2 data-account="recentTitle">Recent activity</h2><div id="account-recent-list" class="dashboard-list"></div></section>
      <section class="card dashboard-panel" id="account-lessons"><h2 data-account="savedLessonsTitle">Latest lessons</h2><div id="records-list" class="dashboard-list"></div></section>
    </div>
    <section class="card dashboard-panel dashboard-wide" id="account-exercises"><h2 data-account="savedExercisesTitle">Exercise answers</h2><p class="muted" data-account="exercisePrivacy">Your saved answers are private. Open a course for its details.</p><div id="account-exercise-list" class="dashboard-list dashboard-list-grid"></div></section>
    <section class="card dashboard-panel dashboard-wide" id="account-analyses"><h2 data-account="analysesTitle">Saved analyses</h2><div id="account-analysis-list" class="dashboard-list"></div></section>
    <section class="dashboard-wide" id="account-course-section"><div class="eyebrow" data-account="courseEyebrow">COURSE DETAIL</div><h2 data-account="performanceTitle">Performance by course</h2><p class="muted" data-account="courseHint">Open a course to see lessons, exercises and test results.</p><div id="account-courses" class="course-detail-list"></div></section>
    <a class="button gold" href="/levels/" data-account="continue">Continue learning →</a>
  </div></section>
  <section class="section ai-keys" id="connect-ai" hidden><div class="shell ai-key-grid">
    <div><div class="eyebrow" data-account="connectAiEyebrow">PRIVATE MCP ACCESS</div><h2 data-account="connectAi">Connect your AI</h2><p data-account="connectAiIntro">Create a personal key to let your AI study with your account, save answers and track progress. Public reading stays open without a key.</p><p class="muted" data-account="keySafety">Keep the key in your AI client's private credential field. It is shown only once. Revoke it here at any time.</p><p><a class="text-link" href="/for-ai/" data-account="aiGuide">How the MCP connection works →</a></p></div>
    <div class="card key-manager"><form id="ai-key-form"><label for="ai-key-label" data-account="keyName">Key name</label><input id="ai-key-label" type="text" minlength="1" maxlength="60" required placeholder="My AI on my computer" /><button class="button gold" type="submit" data-account="createKey">Create key</button></form><p id="ai-key-message" class="muted" role="status" aria-live="polite"></p><div id="ai-key-once" class="key-once" hidden><strong data-account="keyOnce">Copy this key now. It will not be shown again.</strong><code id="ai-key-secret"></code><div class="key-actions"><button id="ai-key-copy" class="button secondary" type="button" data-account="copyKey">Copy key</button><button id="ai-key-dismiss" class="button secondary" type="button" data-account="dismissKey">Done</button></div></div><h3 data-account="yourKeys">Your keys</h3><div id="ai-key-list" class="dashboard-list"></div></div>
  </div></section>
  <script>
    import { initializeStudentAccount } from '../lib/student-account';
    void initializeStudentAccount();
  </script>
</BaseLayout>
<style is:global>
  [hidden] { display: none !important; }
  .account-hero { padding: clamp(42px,6vw,88px) 0; background: radial-gradient(circle at 18% 8%,rgba(21,59,112,.42),transparent 45%),linear-gradient(115deg,var(--bg-2),var(--bg)); border-bottom: 1px solid var(--line); }.account-hero h1 { font-size: clamp(2.7rem,4.7vw,4.6rem); line-height: 1.08; margin: 14px 0 20px; max-width: 680px; }.account-intro p { color: var(--muted); max-width: 590px; font-size: 1.1rem; }.account-intro a { display: inline-flex; margin-top: 10px; color: var(--gold); font-weight: 600; }
  .account-grid { display: grid; grid-template-columns: minmax(0,1fr) minmax(360px,470px); gap: clamp(24px,5vw,82px); align-items: center; }.account-grid .card,.benefits { padding: 32px; }.profile { min-height: 340px; border-top: 3px solid var(--gold); box-shadow: 0 22px 55px rgba(0,0,0,.16); }.profile-brand { display: flex; align-items: center; gap: 12px; font-size: 1.15rem; font-weight: 600; margin-bottom: 28px; }.profile-brand img { flex: none; }.profile h2,.benefits h2 { font-size: 1.6rem; margin: 12px 0; overflow-wrap: anywhere; }.profile p { max-width: 480px; }.profile .button { margin-top: 15px; }.profile form { display: grid; gap: 12px; max-width: 420px; margin-top: 24px; }.profile form[hidden],.profile button[hidden],.return-after-signin[hidden] { display: none; }.profile input { width: 100%; padding: 12px; border: 1px solid var(--line); border-radius: 4px; background: var(--surface); color: var(--text); font: inherit; }.profile input:focus-visible { outline: 2px solid var(--gold); }.profile #account-logout { margin-top: 18px; }.return-after-signin { border-left: 2px solid var(--gold); padding-left: 12px; color: var(--muted); font-size: .9rem; }.benefits { max-width: 850px; }.benefit { display: flex; gap: 14px; border-top: 1px solid var(--line); padding-top: 15px; margin-top: 15px; }.benefit>span { color: var(--gold); font-weight: 600; }.benefit strong { font-size: .95rem; }.benefit p { color: var(--muted); font-size: .84rem; margin: 3px 0 0; }
  .records { background: var(--bg-2); border-top: 1px solid var(--line); }.records h2 { margin-top: 12px; }.record-list { display: grid; grid-template-columns: repeat(2,1fr); gap: 10px; margin: 22px 0 34px; }.record { display: grid; gap: 4px; padding: 16px 18px; background: var(--surface); border: 1px solid var(--line); border-radius: 4px; }.record strong { text-transform: capitalize; }.record span { color: var(--muted); font-size: .8rem; }
  .account-signed-in .account-intro,.account-signed-in .account-benefits { display: none; }.account-signed-in .account-hero { padding: 26px 0; }.account-signed-in .account-grid { display: block; }.account-signed-in .profile { min-height: 0; display: flex; align-items: center; gap: 22px; flex-wrap: wrap; padding: 18px 24px; box-shadow: none; }.account-signed-in .profile-brand { margin: 0 auto 0 0; }.account-signed-in .profile>.eyebrow { display: none; }.account-signed-in .profile h2 { font-size: 1.25rem; margin: 0; }.account-signed-in .profile p { margin: 0; }.account-signed-in .profile #account-logout { margin: 0; }.account-signed-in .profile #account-message { width: 100%; }
  .records { padding-top: 48px; }.records h1 { font-size: clamp(2rem,4vw,3.3rem); margin: 9px 0; }.account-jump { display: flex; gap: 8px; flex-wrap: wrap; margin: 26px 0 30px; }.account-jump a { border: 1px solid var(--line); background: var(--surface); border-radius: 3px; padding: 7px 12px; font-size: .87rem; }.account-jump a:hover { border-color: var(--gold); }
  .metric-grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 12px; margin-bottom: 30px; }.metric { display: grid; gap: 3px; min-height: 116px; padding: 17px; border: 1px solid var(--line); border-top: 2px solid var(--gold); border-radius: 4px; background: var(--surface); }.metric-value { font-size: 2rem; line-height: 1; color: var(--gold); font-weight: 600; }.metric-label { color: var(--text); font-size: .94rem; }.metric-detail { color: var(--muted); font-size: .78rem; }.metric:hover { border-color: var(--gold); }
  .dashboard-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 16px; }.dashboard-panel { padding: 23px; box-shadow: none; }.dashboard-panel h2,.dashboard-wide h2 { font-size: 1.4rem; }.dashboard-list { display: grid; gap: 8px; }.dashboard-list-grid { grid-template-columns: repeat(2,minmax(0,1fr)); }.dashboard-list .record { padding: 12px 14px; background: var(--bg-2); }.dashboard-wide { margin-top: 20px; }.course-detail-list { display: grid; gap: 12px; margin: 22px 0 30px; }.course-detail { border: 1px solid var(--line); background: var(--surface); border-radius: 4px; }.course-detail>summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; gap: 14px; align-items: center; padding: 16px 20px; }.course-detail>summary::-webkit-details-marker { display: none; }.course-detail>summary::after { content: '⌄'; color: var(--gold); }.course-detail[open]>summary::after { content: '⌃'; }.course-detail-body { border-top: 1px solid var(--line); padding: 20px; display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 20px; }.course-detail-body h3 { font-size: 1rem; }.course-detail-body .record { margin-bottom: 7px; }.empty-note { color: var(--muted); font-size: .9rem; }
  .analysis-detail { border: 1px solid var(--line); border-radius: 4px; background: var(--bg-2); padding: 12px 16px; }.analysis-detail summary { cursor: pointer; }.analysis-note { white-space: pre-wrap; overflow-wrap: anywhere; color: var(--text); max-height: 20rem; overflow-y: auto; }.analysis-detail .text-link { display: inline-block; margin-bottom: 8px; }
  .ai-keys { border-top: 1px solid var(--line); }.ai-key-grid { display: grid; grid-template-columns: minmax(0,.9fr) minmax(0,1.1fr); gap: 40px; }.ai-keys h2 { margin-top: 10px; }.key-manager { padding: 24px; }.key-manager form { display: grid; gap: 10px; }.key-manager input { width: 100%; padding: 11px 13px; color: var(--text); background: var(--bg-2); border: 1px solid var(--line); border-radius: 4px; }.key-manager h3 { font-size: 1.08rem; margin-top: 30px; }.key-once { display: grid; gap: 12px; border: 1px solid var(--gold); background: var(--gold-soft); padding: 15px; }.key-once code { font-size: .86rem; overflow-wrap: anywhere; }.key-actions { display: flex; gap: 10px; flex-wrap: wrap; }.key-row { display: flex; justify-content: space-between; gap: 10px; align-items: center; padding: 12px; border: 1px solid var(--line); border-radius: 3px; }.key-row small { display: block; color: var(--muted); }.key-row button { border: 1px solid var(--line); background: transparent; color: var(--text); border-radius: 3px; padding: 5px 10px; }.key-row button:hover { border-color: var(--gold); }
  @media(max-width:850px){.account-grid,.record-list{grid-template-columns:1fr}.account-hero{padding:42px 0 56px}.account-grid .card,.benefits{padding:24px}}
  @media(max-width:850px){.metric-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.dashboard-grid,.ai-key-grid{grid-template-columns:1fr}.course-detail-body{grid-template-columns:1fr}}
  @media(max-width:530px){.metric-grid,.dashboard-list-grid{grid-template-columns:1fr}.account-signed-in .profile-brand{width:100%;}.account-signed-in .profile{gap:12px}}
</style>
