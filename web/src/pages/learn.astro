---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Find a course · OpenCyber Academy" description="Browse OpenCyber Academy courses by level or subject, then open each course's own lessons and book." robots="noindex,follow">
  <section class="directory-heading"><div class="shell"><div class="eyebrow">COURSE DIRECTORY</div><h1>Choose a course.</h1><p>Use the level menu to see all subjects at one study level, or the subject menu to compare that subject across levels. Each course opens on its own page.</p><div class="directory-switch"><a class="button gold" href="/levels/" data-language-link>Browse by level</a><a class="button secondary" href="/subjects/" data-language-link>Browse by subject</a></div><p id="legacy-status" class="muted" role="status"></p></div></section>
  <script>
    import { siteLanguage } from '../lib/i18n';
    const query = new URLSearchParams(location.search);
    const level = query.get('level'), area = query.get('area');
    const language = query.get('lang') || siteLanguage();
    const chapter = query.get('chapter');
    const valid = (value: string | null) => Boolean(value && /^[a-z0-9-]+$/.test(value));
    if (valid(level) && valid(area)) {
      const params = new URLSearchParams({ lang: language });
      if (chapter && /^\d+$/.test(chapter)) params.set('chapter', chapter);
      location.replace(`/courses/${level}/${area}/?${params}`);
    } else if (valid(level)) location.replace(`/levels/${level}/?lang=${encodeURIComponent(language)}`);
    else if (valid(area)) location.replace(`/subjects/${area}/?lang=${encodeURIComponent(language)}`);
    else if (query.has('course')) {
      try {
        const response = await fetch('/api/catalog');
        const data = await response.json();
        const course = data.courses.find((item: { number: number }) => item.number === Number(query.get('course')));
        if (course) location.replace(`/courses/${course.level}/${course.area}/?lang=${encodeURIComponent(language)}`);
      } catch { document.getElementById('legacy-status')!.textContent = 'Choose a course using the menus above.'; }
    }
  </script>
</BaseLayout>
