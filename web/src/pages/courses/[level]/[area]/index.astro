---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { catalog, coursePath, levelPath, subjectPath } from '../../../../lib/catalog';

export function getStaticPaths() {
  return catalog.courses.map(course => ({ params: { level: course.level, area: course.area }, props: { course } }));
}
const { course } = Astro.props;
const position = catalog.courses.findIndex(item => item.number === course.number);
const previous = catalog.courses[position - 1];
const next = catalog.courses[position + 1];
const levelName = catalog.level_names[course.level].en;
const courseCode = `OCA-${String(course.number).padStart(3, '0')}`;
const courseUrl = `https://opencyber.academy${coursePath(course.level, course.area)}`;
const structuredData = [
  { '@context': 'https://schema.org', '@type': 'Course', name: `${levelName} ${course.title}`, courseCode, description: `Free ${levelName.toLowerCase()} cybersecurity learning in ${course.title}, with authored lessons, examples and exercises.`, url: courseUrl, isAccessibleForFree: true, provider: { '@type': 'Organization', name: 'OpenCyber Academy', url: 'https://opencyber.academy/' } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://opencyber.academy/' },
    { '@type': 'ListItem', position: 2, name: levelName, item: `https://opencyber.academy${levelPath(course.level)}` },
    { '@type': 'ListItem', position: 3, name: course.title, item: courseUrl },
  ] },
];
---
<BaseLayout title={`${levelName} · ${course.title} · OpenCyber Academy`} description={`Study the free ${levelName.toLowerCase()} course in ${course.title}: public lessons, examples, exercises and worked answers. No registration required.`} structuredData={structuredData}>
  <div id="course-root" data-level={course.level} data-area={course.area} data-number={course.number} data-next={next ? coursePath(next.level, next.area) : ''}>
    <section class="course-heading"><div class="shell">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/levels/" data-language-link>Levels</a><span>›</span><a href={levelPath(course.level)} data-language-link>{levelName}</a><span>›</span><span>{course.title}</span></nav>
      <div class="eyebrow">{courseCode} · <span>{levelName}</span></div>
      <h1>{course.title}</h1>
      <p>Free cybersecurity education for anyone who wants to protect people and technology. Study published lessons, examples and exercises without creating an account.</p>
      <div class="course-heading-actions">
        <a class="button secondary" href={subjectPath(course.area)} data-language-link>Other levels in this subject →</a>
        <a class="button secondary" href={levelPath(course.level)} data-language-link>All courses at this level →</a>
        <a class="button gold" href={`/tests/?level=${course.level}&area=${course.area}`} data-test-link>Test yourself →</a>
      </div>
    </div></section>
    <div id="live-lesson-directory"></div>
    <nav class="shell directory-foot" aria-label="Adjacent courses">
      {previous && <a href={`${coursePath(previous.level, previous.area)}start/`} data-language-link>← Previous course</a>}
      <a href={levelPath(course.level)} data-language-link>All courses at this level</a>
      {next && <a href={`${coursePath(next.level, next.area)}start/`} data-language-link>Next course →</a>}
    </nav>
  </div>
</BaseLayout>
