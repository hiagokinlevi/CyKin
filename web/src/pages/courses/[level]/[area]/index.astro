---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { catalog, coursePath, levelPath, subjectPath } from '../../../../lib/catalog';
import lessonIndexData from '../../../../../public/lesson-index.json';

export function getStaticPaths() {
  return catalog.courses.map(course => ({ params: { level: course.level, area: course.area }, props: { course } }));
}
const { course } = Astro.props;
const position = catalog.courses.findIndex(item => item.number === course.number);
const previous = catalog.courses[position - 1];
const next = catalog.courses[position + 1];
const levelName = catalog.level_names[course.level].en;
type IndexedUnit = { number: number; title: string };
const lessonIndex = lessonIndexData as Record<string, { lessons: IndexedUnit[]; chapters: IndexedUnit[] }>;
const authoredEditions = catalog.languages.map(language => ({ language, units: lessonIndex[`${course.level}/${course.area}/${language}`] })).filter(edition => edition.units);
const courseUrl = `https://opencyber.academy${coursePath(course.level, course.area)}`;
const structuredData = [
  { '@context': 'https://schema.org', '@type': 'Course', name: `${levelName} ${course.title}`, description: `Free ${levelName.toLowerCase()} cybersecurity learning in ${course.title}, with authored lessons, examples and exercises.`, url: courseUrl, isAccessibleForFree: true, provider: { '@type': 'Organization', name: 'OpenCyber Academy', url: 'https://opencyber.academy/' } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://opencyber.academy/' },
    { '@type': 'ListItem', position: 2, name: levelName, item: `https://opencyber.academy${levelPath(course.level)}` },
    { '@type': 'ListItem', position: 3, name: course.title, item: courseUrl },
  ] },
];
---
<BaseLayout title={`${levelName} · ${course.title} · OpenCyber Academy`} description={`Study the free ${levelName.toLowerCase()} course in ${course.title}: public lessons, examples, exercises and worked answers. No registration required.`} structuredData={structuredData}>
  <div id="course-root" data-level={course.level} data-area={course.area} data-number={course.number} data-next={next ? coursePath(next.level, next.area) : ''}>
    <section class="course-heading"><div class="shell">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/levels/" data-language-link>Levels</a><span>›</span><a href={levelPath(course.level)} data-language-link>{levelName}</a><span>›</span><span>{course.title}</span></nav>
      <div class="eyebrow">COURSE {String(course.number).padStart(3, '0')} · <span>{levelName}</span></div>
      <h1>{course.title}</h1>
      <p>Free cybersecurity education for anyone who wants to protect people and technology. Study published lessons, examples and exercises without creating an account.</p>
      <div class="course-heading-actions">
        <div class="field course-language"><label for="course-language">Course language</label><select id="course-language"><option value="en">English</option><option value="pt">Português</option><option value="es">Español</option><option value="he">עברית</option><option value="fr">Français</option><option value="ru">Русский</option><option value="de">Deutsch</option><option value="zh">中文</option><option value="ja">日本語</option></select></div>
        <a class="button secondary" href={subjectPath(course.area)} data-language-link>Other levels in this subject →</a>
        <a class="button secondary" href={levelPath(course.level)} data-language-link>All courses at this level →</a>
      </div>
      <p id="course-status" class="status" role="status">Loading this course…</p>
      <div id="course-facts" class="course-facts" hidden></div>
    </div></section>
    {authoredEditions.length > 0 && <section class="shell published-lesson-directory" aria-labelledby="published-lessons-title">
      <h2 id="published-lessons-title">Published lessons in this course</h2>
      <p>Each link opens the complete lesson on its own permanent page. New manuscript edits appear there after publication.</p>
      {authoredEditions.map(({ language, units }) => <details data-edition={language}>
        <summary>{language.toUpperCase()} · {units.lessons.length} daily lessons · {units.chapters.length} full chapters</summary>
        <div class="published-lesson-links">
          {units.lessons.map(unit => <a href={`/courses/${course.level}/${course.area}/lessons/${language}/${unit.number}/`}><span>{`Lesson ${unit.number}:`}</span> {unit.title}</a>)}
          {units.chapters.map(unit => <a href={`/courses/${course.level}/${course.area}/chapters/${language}/${unit.number}/`}><span>{`Chapter ${unit.number}:`}</span> {unit.title}</a>)}
        </div>
      </details>)}
    </section>}
    <section class="course-workspace shell">
      <aside class="card course-sidebar" aria-label="Lessons in this course"><div class="course-sidebar-head"><div class="eyebrow">COURSE CONTENTS</div><h2>Study guide</h2><p>Choose one study week or browse the complete chapters.</p><a id="course-overview-link" href="?lang=en">← Course overview</a></div><nav id="course-lessons" aria-label="Course lessons"></nav></aside>
      <div class="card course-reader">
        <div id="course-lesson-top" class="course-lesson-top" hidden><span id="course-position"></span><a id="course-top-overview" href="?lang=en">Course overview</a></div>
        <div id="course-kicker" class="reader-kicker">COURSE {String(course.number).padStart(3, '0')}</div>
        <h2 id="course-reader-title">{course.title}</h2>
        <p id="course-intro" class="muted">Loading the current book and lesson guide…</p>
        <div id="course-overview" class="course-overview"></div>
        <nav id="course-lesson-nav-top" class="lesson-nav course-nav-top" aria-label="Lesson navigation at top" hidden></nav>
        <div id="course-source" class="source-bar"></div>
        <article id="course-markdown" class="prose" hidden></article>
        <section id="course-answers" class="answer-section" hidden><details><summary>View worked answers</summary><div id="course-answer-markdown" class="prose"></div></details></section>
        <section id="course-progress" class="progress-tools" hidden><div class="eyebrow">YOUR PROGRESS · OPTIONAL</div><h3>Save this lesson</h3><p>Reading is open without an account. Saving progress with optional sign-in will be added later.</p><div id="course-progress-action"></div><div id="course-exercise-forms"></div><p id="course-progress-status" role="status"></p></section>
        <nav id="course-lesson-nav" class="lesson-nav" aria-label="Lesson navigation"></nav>
      </div>
    </section>
    <nav class="shell directory-foot" aria-label="Adjacent courses">
      {previous && <a href={coursePath(previous.level, previous.area)} data-language-link>← Previous course</a>}
      <a href={levelPath(course.level)} data-language-link>All courses at this level</a>
      {next && <a href={coursePath(next.level, next.area)} data-language-link>Next course →</a>}
    </nav>
  </div>
  <script>
    import { initCoursePortal } from '../../../../lib/course-portal';
    void initCoursePortal();
  </script>
</BaseLayout>
