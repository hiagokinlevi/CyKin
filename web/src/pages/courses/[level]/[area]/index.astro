---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { catalog, coursePath, levelPath, subjectPath } from '../../../../lib/catalog';

export function getStaticPaths() {
  return catalog.courses.map(course => ({ params: { level: course.level, area: course.area }, props: { course } }));
}
const { course } = Astro.props;
const position = catalog.courses.findIndex(item => item.number === course.number);
const previous = catalog.courses[position - 1];
const next = catalog.courses[position + 1];
const levelName = catalog.level_names[course.level].en;
---
<BaseLayout title={`${levelName} · ${course.title} · CyKin`} description={`Read the ${levelName.toLowerCase()} course in ${course.title}, with its own book, lessons, exercises and navigation.`}>
  <div id="course-root" data-level={course.level} data-area={course.area} data-number={course.number} data-next={next ? coursePath(next.level, next.area) : ''}>
    <section class="course-heading"><div class="shell">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/levels/" data-language-link>Levels</a><span>›</span><a href={levelPath(course.level)} data-language-link>{levelName}</a><span>›</span><span>{course.title}</span></nav>
      <div class="eyebrow">COURSE {String(course.number).padStart(3, '0')} · <span>{levelName}</span></div>
      <h1>{course.title}</h1>
      <p>One course, one book. Study one lesson each weekday, normally in a weekly chapter with five lessons. Each lesson has a worked example and an exercise. Read what is published below.</p>
      <div class="course-heading-actions">
        <div class="field course-language"><label for="course-language">Course language</label><select id="course-language"><option value="en">English</option><option value="pt">Português</option><option value="es">Español</option><option value="he">עברית</option><option value="fr">Français</option><option value="ru">Русский</option><option value="de">Deutsch</option><option value="zh">中文</option><option value="ja">日本語</option></select></div>
        <a class="button secondary" href={subjectPath(course.area)} data-language-link>Other levels in this subject →</a>
        <a class="button secondary" href={levelPath(course.level)} data-language-link>All courses at this level →</a>
      </div>
      <p id="course-status" class="status" role="status">Loading this course…</p>
      <div id="course-facts" class="course-facts" hidden></div>
    </div></section>
    <section class="course-workspace shell">
      <aside class="card course-sidebar" aria-label="Lessons in this course"><div class="course-sidebar-head"><div class="eyebrow">COURSE CONTENTS</div><h2>Chapters and lessons</h2><p>Open each chapter to find its daily lessons.</p><a id="course-overview-link" href="?lang=en">← Course overview</a></div><nav id="course-lessons" aria-label="Course lessons"></nav></aside>
      <div class="card course-reader">
        <div id="course-lesson-top" class="course-lesson-top" hidden><span id="course-position"></span><a id="course-top-overview" href="?lang=en">Course overview</a></div>
        <div id="course-kicker" class="reader-kicker">COURSE {String(course.number).padStart(3, '0')}</div>
        <h2 id="course-reader-title">{course.title}</h2>
        <p id="course-intro" class="muted">Loading the current book and lesson guide…</p>
        <div id="course-overview" class="course-overview"></div>
        <nav id="course-lesson-nav-top" class="lesson-nav course-nav-top" aria-label="Lesson navigation at top" hidden></nav>
        <div id="course-source" class="source-bar"></div>
        <article id="course-markdown" class="prose" hidden></article>
        <section id="course-answers" class="answer-section" hidden><details><summary>View worked answers</summary><div id="course-answer-markdown" class="prose"></div></details></section>
        <section id="course-progress" class="progress-tools" hidden><div class="eyebrow">YOUR PROGRESS · OPTIONAL</div><h3>Save this lesson</h3><p>You can study without an account. With sign-in, mark lessons and save your answers.</p><div id="course-progress-action"></div><div id="course-exercise-forms"></div><p id="course-progress-status" role="status"></p></section>
        <nav id="course-lesson-nav" class="lesson-nav" aria-label="Lesson navigation"></nav>
      </div>
    </section>
    <nav class="shell directory-foot" aria-label="Adjacent courses">
      {previous && <a href={coursePath(previous.level, previous.area)} data-language-link>← Previous course</a>}
      <a href={levelPath(course.level)} data-language-link>All courses at this level</a>
      {next && <a href={coursePath(next.level, next.area)} data-language-link>Next course →</a>}
    </nav>
  </div>
  <script>
    import { renderMarkdown } from '../../../../lib/reader';
    import { siteLanguage } from '../../../../lib/i18n';

    type Lesson = { chapter: number; title: string; subject: string; module: number; published: boolean; source_url: string };
    type Module = { number: number; kind: string; title: string; chapters: number[] };
    type Details = { course: { instructional_weeks: number; study_days_per_week: number; daily_lesson_target: number; minimum_exercises: number; minimum_a4_pages: number }; lessons: Lesson[]; modules: Module[]; published_chapters: number; planned_chapters: number; published_lessons: number; planned_lessons: number; has_daily_lessons: boolean; daily_schedule_ready: boolean; book_url: string | null };
    type LessonData = { chapter: number; title: string; markdown: string; worked_answers: string; exercise_ids: string[]; source_url: string };
    const $ = (id: string) => document.getElementById(id)!;
    const root = $('course-root');
    const level = root.dataset.level!, area = root.dataset.area!;
    const number = Number(root.dataset.number);
    const query = new URLSearchParams(location.search);
    const selector = $('course-language') as HTMLSelectElement;
    let language = query.get('lang') || siteLanguage();
    if (!['en', 'pt', 'es', 'he', 'fr', 'ru', 'de', 'zh', 'ja'].includes(language)) language = 'en';
    selector.value = language;
    let details: Details | null = null;
    let currentChapter: number | null = null;
    let requestId = 0;

    function chapterUrl(chapter: number | null) {
      const params = new URLSearchParams({ lang: language });
      if (query.has('ui')) params.set('ui', query.get('ui')!);
      if (chapter !== null) params.set('chapter', String(chapter));
      return location.pathname + '?' + params;
    }
    function updateLocation(chapter: number | null, push: boolean) {
      const target = chapterUrl(chapter);
      if (location.pathname + location.search !== target) history[push ? 'pushState' : 'replaceState'](null, '', target);
    }
    function link(label: string, href: string, className = 'button secondary') {
      const a = document.createElement('a'); a.href = href; a.className = className; a.textContent = label; return a;
    }
    function moduleLabel(module: Module) { return module.kind === 'Chapter' ? `Chapter ${String(module.number).padStart(2, '0')} · ${module.title}` : module.kind === 'Module' ? `Module ${module.number}` : `Module ${module.number} · ${module.kind} ${module.number}`; }
    function moduleFor(chapter: number) { return details?.modules.find(module => module.chapters.includes(chapter)); }
    function lessonLink(lesson: Lesson, className: string) {
      const item = link('', chapterUrl(lesson.chapter), className);
      const number = document.createElement('span'); number.className = 'lesson-number'; number.textContent = String(lesson.chapter).padStart(2, '0');
      const subject = document.createElement('span'); subject.className = 'lesson-subject'; subject.textContent = lesson.title;
      const state = document.createElement('span'); state.className = 'lesson-state'; state.textContent = lesson.published ? 'Read lesson →' : 'Not published';
      item.append(number, subject, state);
      item.addEventListener('click', event => { event.preventDefault(); void openLesson(lesson.chapter, true); });
      return item;
    }
    function renderIndex() {
      if (!details) return;
      const nav = $('course-lessons');
      const expanded = new Set([...nav.querySelectorAll<HTMLDetailsElement>('details[open]')].map(item => Number(item.dataset.module)));
      nav.replaceChildren();
      for (const module of details.modules) {
        const section = document.createElement('details'); section.className = 'course-module'; section.dataset.module = String(module.number);
        section.open = expanded.has(module.number) || module.number === (moduleFor(currentChapter || 1)?.number || details.modules[0]?.number);
        const summary = document.createElement('summary');
        const label = document.createElement('span'); label.textContent = moduleLabel(module);
        const count = document.createElement('span'); count.textContent = `${module.chapters.length} lessons`;
        summary.append(label, count); section.append(summary);
        for (const chapter of module.chapters) {
          const lesson = details.lessons.find(item => item.chapter === chapter);
          if (!lesson) continue;
          const item = lessonLink(lesson, 'course-lesson' + (currentChapter === chapter ? ' active' : ''));
          if (currentChapter === chapter) item.setAttribute('aria-current', 'page');
          section.append(item);
        }
        nav.append(section);
      }
    }
    function renderOverview() {
      if (!details) return;
      const overview = $('course-overview'); overview.replaceChildren();
      const cadence = document.createElement('section'); cadence.className = 'course-cadence';
      const cadenceLabel = document.createElement('div'); cadenceLabel.className = 'eyebrow'; cadenceLabel.textContent = 'WEEKDAY STUDY PLAN';
      const cadenceTitle = document.createElement('h3'); cadenceTitle.textContent = `${details.course.instructional_weeks} weeks · ${details.course.daily_lesson_target} daily lessons`;
      const cadenceCopy = document.createElement('p'); cadenceCopy.textContent = 'One lesson each Monday–Friday, normally five lessons in a weekly chapter. Learn the concept, follow a worked example, then solve an exercise. The plan applies to every language edition.';
      const weekdays = document.createElement('div'); weekdays.className = 'course-weekdays';
      for (const day of ['Mon', 'Tue', 'Wed', 'Thu', 'Fri']) { const chip = document.createElement('span'); chip.textContent = day; weekdays.append(chip); }
      const availability = document.createElement('p'); availability.className = 'course-availability'; availability.textContent = details.has_daily_lessons
        ? `${details.published_chapters} chapters and ${details.published_lessons} of ${details.planned_lessons} indexed daily lessons published in this edition.`
        : `${details.published_chapters} current subject chapters published. Distinct daily lessons have not yet been indexed for this edition; the ${details.course.daily_lesson_target}-lesson baseline is a plan, not published content.`;
      cadence.append(cadenceLabel, cadenceTitle, cadenceCopy, weekdays, availability); overview.append(cadence);
      const heading = document.createElement('h3'); heading.textContent = 'Your course roadmap'; overview.append(heading);
      const modules = document.createElement('div'); modules.className = 'course-module-grid';
      for (const module of details.modules) {
        const card = document.createElement('section'); card.className = 'course-module-card';
        const title = document.createElement('h4'); title.textContent = moduleLabel(module);
        const count = document.createElement('p');
        const available = module.chapters.filter(chapter => details!.lessons.find(item => item.chapter === chapter)?.published).length;
        count.textContent = `${available} of ${module.chapters.length} lessons available`;
        card.append(title, count);
        const list = document.createElement('div'); list.className = 'course-module-list';
        for (const chapter of module.chapters) {
          const lesson = details.lessons.find(item => item.chapter === chapter);
          if (lesson) list.append(lessonLink(lesson, 'course-overview-lesson'));
        }
        card.append(list); modules.append(card);
      }
      overview.append(modules);
    }
    function renderFacts() {
      if (!details) return;
      const facts = $('course-facts'); facts.replaceChildren(); facts.hidden = false;
      for (const value of [`${details.course.instructional_weeks} weekly chapters planned`, `${details.course.daily_lesson_target} daily lessons planned`, `${details.published_chapters} chapters published`, `${details.published_lessons} daily lessons published`]) {
        const fact = document.createElement('span'); fact.textContent = value; facts.append(fact);
      }
    }
    function renderNavigation(chapter: number | null) {
      if (!details) return;
      for (const nav of [$('course-lesson-nav-top'), $('course-lesson-nav')]) {
        nav.replaceChildren(); nav.hidden = nav.id === 'course-lesson-nav-top' && chapter === null;
        if (chapter === null) {
          const first = details.lessons.find(item => item.published);
          if (first) nav.append(link('Start first published lesson →', chapterUrl(first.chapter), 'button gold'));
        } else {
          const index = details.lessons.findIndex(item => item.chapter === chapter);
          const previous = details.lessons[index - 1], next = details.lessons[index + 1];
          if (previous) nav.append(link('← Previous lesson', chapterUrl(previous.chapter)));
          nav.append(link('Course overview', chapterUrl(null)));
          if (next) nav.append(link('Next lesson →', chapterUrl(next.chapter)));
          else if (root.dataset.next) nav.append(link('Next course →', root.dataset.next + `?${new URLSearchParams({ lang: language, ...(query.has('ui') ? { ui: query.get('ui')! } : {}) })}`));
        }
        for (const anchor of nav.querySelectorAll<HTMLAnchorElement>('a')) {
          if (!anchor.href.startsWith(location.origin + location.pathname)) continue;
          anchor.addEventListener('click', event => { event.preventDefault(); const value = new URL(anchor.href).searchParams.get('chapter'); void openLesson(value ? Number(value) : null, true); });
        }
      }
    }
    async function showProgress(lesson: LessonData) {
      const tools = $('course-progress'), action = $('course-progress-action'), forms = $('course-exercise-forms');
      tools.hidden = false; action.replaceChildren(); forms.replaceChildren(); $('course-progress-status').textContent = '';
      try {
        const me = await fetch('/private/me', { credentials: 'same-origin', cache: 'no-store', redirect: 'manual' });
        if (!me.ok) throw new Error('Sign-in unavailable');
      } catch { action.append(link('Sign in to save progress →', '/account/')); return; }
      const base = { level, area, language, chapter: lesson.chapter };
      const mark = document.createElement('button'); mark.className = 'button gold'; mark.type = 'button'; mark.textContent = 'Mark lesson complete ✓';
      mark.addEventListener('click', async () => {
        const response = await fetch('/private/progress/lesson', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ ...base, status: 'completed' }) });
        $('course-progress-status').textContent = response.ok ? 'Lesson completed and saved to your account.' : 'Could not save right now.';
      }); action.append(mark);
      for (const digits of lesson.exercise_ids) {
        const id = `EX${digits}`, form = document.createElement('form'); form.className = 'exercise-form';
        const label = document.createElement('label'); label.textContent = `Your answer for ${id}`; label.htmlFor = `answer-${id}`;
        const input = document.createElement('textarea'); input.id = `answer-${id}`; input.maxLength = 20_000; input.rows = 4; input.placeholder = 'Save your attempt, then compare the worked answer.';
        const save = document.createElement('button'); save.type = 'submit'; save.className = 'button secondary'; save.textContent = 'Save attempt';
        form.append(label, input, save);
        form.addEventListener('submit', async event => {
          event.preventDefault(); save.disabled = true;
          try {
            const response = await fetch('/private/progress/exercise', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ ...base, exercise_id: id, answer: input.value, status: 'attempted' }) });
            $('course-progress-status').textContent = response.ok ? `${id} saved to your account.` : `Could not save ${id}.`;
          } catch { $('course-progress-status').textContent = `Could not save ${id}.`; }
          finally { save.disabled = false; }
        }); forms.append(form);
      }
    }
    async function openLesson(chapter: number | null, push = false) {
      if (!details) return;
      const id = ++requestId;
      const item = chapter === null ? null : details.lessons.find(lesson => lesson.chapter === chapter);
      if (chapter !== null && !item) return;
      currentChapter = chapter; updateLocation(chapter, push); renderIndex(); renderNavigation(chapter);
      $('course-markdown').hidden = true; $('course-answers').hidden = true; $('course-progress').hidden = true;
      $('course-overview').hidden = chapter !== null;
      $('course-lesson-top').hidden = chapter === null;
      $('course-reader-title').hidden = Boolean(item?.published);
      const source = $('course-source'); source.replaceChildren();
      if (push) $('course-reader-title').scrollIntoView({ behavior: 'smooth', block: 'start' });
      if (!item) {
        $('course-kicker').textContent = `COURSE ${String(number).padStart(3, '0')}`;
        $('course-reader-title').textContent = root.querySelector('h1')?.textContent || '';
        $('course-intro').textContent = details.has_daily_lessons
          ? `${details.published_chapters} chapters and ${details.published_lessons} daily lessons are published in this edition.`
          : `${details.published_chapters} legacy subject chapters are published. The daily lessons are still being developed.`;
        if (details.book_url) source.append(link('Read the full book here →', `/book/?${new URLSearchParams({ level, area, lang: language, ...(query.has('ui') ? { ui: query.get('ui')! } : {}) })}`));
        renderOverview();
        return;
      }
      const module = moduleFor(chapter);
      $('course-position').textContent = `${module ? moduleLabel(module) + ' · ' : ''}${details.has_daily_lessons ? 'Lesson' : 'Legacy chapter'} ${chapter} of ${details.has_daily_lessons ? details.planned_lessons : details.planned_chapters}`;
      $('course-kicker').textContent = `LESSON ${String(chapter).padStart(2, '0')} · COURSE ${String(number).padStart(3, '0')}`;
      $('course-reader-title').textContent = item.title;
      if (item.published) source.append(link('Read the full book here →', `/book/?${new URLSearchParams({ level, area, lang: language, ...(query.has('ui') ? { ui: query.get('ui')! } : {}) })}#${details.has_daily_lessons ? 'lesson' : 'ch'}-${String(chapter).padStart(2, '0')}`));
      if (!item.published) { $('course-intro').textContent = 'This lesson has not been published in this edition yet. Choose another available lesson or return to the course overview.'; return; }
      $('course-intro').textContent = 'Loading the published lesson…';
      try {
        const response = await fetch(`/api/lessons/${level}/${area}/${language}/${chapter}`);
        if (!response.ok) throw new Error('The lesson is temporarily unavailable.');
        const lesson = await response.json() as LessonData;
        if (id !== requestId) return;
        $('course-intro').textContent = `${lesson.exercise_ids.length} exercises · Worked answers below`;
        await renderMarkdown($('course-markdown'), lesson.markdown, lesson.source_url, language);
        if (id !== requestId) return;
        $('course-markdown').hidden = false;
        const exerciseHeading = [...$('course-markdown').querySelectorAll('h2,h3,h4')].find(element => /(?:chapter|lesson)\s+\d+\s+(?:exercises|practice)|practice\s+—\s+(?:chapter|lesson)\s+\d+/i.test(element.textContent || ''));
        if (exerciseHeading) { exerciseHeading.id = 'lesson-exercises'; source.append(link('Jump to exercises ↓', '#lesson-exercises')); }
        if (lesson.worked_answers) { await renderMarkdown($('course-answer-markdown'), lesson.worked_answers, lesson.source_url, language); $('course-answers').hidden = false; }
        if (id === requestId) void showProgress(lesson);
        $('course-status').textContent = `Lesson ${chapter} loaded from the public book.`;
      } catch (error) { if (id === requestId) $('course-intro').textContent = String(error); }
    }
    selector.addEventListener('change', () => {
      try { localStorage.setItem('cykin-language', selector.value); } catch { /* private mode */ }
      location.href = location.pathname + '?' + new URLSearchParams({ lang: selector.value, ...(query.has('ui') ? { ui: query.get('ui')! } : {}), ...(currentChapter ? { chapter: String(currentChapter) } : {}) });
    });
    for (const anchor of [$('course-overview-link'), $('course-top-overview')] as HTMLAnchorElement[]) {
      anchor.href = chapterUrl(null);
      anchor.addEventListener('click', event => { event.preventDefault(); void openLesson(null, true); });
    }
    window.addEventListener('popstate', () => { const chapter = Number(new URLSearchParams(location.search).get('chapter')) || null; void openLesson(chapter); });
    try {
      const response = await fetch(`/api/courses/${level}/${area}/${language}`);
      if (!response.ok) throw new Error('This course could not be loaded.');
      details = await response.json() as Details;
      $('course-status').textContent = 'Course guide loaded.';
      renderFacts();
      await openLesson(Number(query.get('chapter')) || null);
    } catch (error) { $('course-status').textContent = String(error); $('course-intro').textContent = 'This course is temporarily unavailable. Please try again shortly.'; }
  </script>
</BaseLayout>
