---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Public reference · CyKin" description="Read public CyKin course references on the site.">
  <section class="reference-heading"><div class="shell"><div class="eyebrow">OPEN REFERENCE</div><h1 id="reference-title">Course reference</h1><p id="reference-status" role="status">Loading the document…</p><a class="button secondary" href="/learn/">Browse courses →</a></div></section>
  <section class="section"><article id="reference-content" class="shell card prose reference-content"></article></section>
  <script>
    import { renderMarkdown, sourceUrlFor } from '../lib/reader';
    const path = new URLSearchParams(location.search).get('path') || '';
    const status = document.getElementById('reference-status')!;
    if (!path.endsWith('.md') || path.includes('..') || path.startsWith('/')) status.textContent = 'Choose a document from a course page.';
    else {
      try {
        const response = await fetch('/api/source?' + new URLSearchParams({ path }));
        if (!response.ok) throw new Error('This reference is unavailable.');
        const markdown = await response.text();
        const lang = path.match(/\/(en|pt|es)\//)?.[1] || document.documentElement.lang.slice(0,2) || 'en';
        await renderMarkdown(document.getElementById('reference-content')!, markdown, sourceUrlFor(path), lang, 'reference');
        document.getElementById('reference-title')!.textContent = path.split('/').at(-1)!.replace('.md','').replaceAll('_',' ');
        status.textContent = 'Public document · linked course references open within CyKin.';
        if (location.hash) document.getElementById(decodeURIComponent(location.hash.slice(1)))?.scrollIntoView();
      } catch (error) { status.textContent = String(error); }
    }
  </script>
</BaseLayout>
<style>
  .reference-heading { padding: 62px 0 40px; background: var(--bg-2); border-bottom: 1px solid var(--line); }.reference-heading p { color: var(--muted); }.reference-content { padding: clamp(25px,4vw,55px); min-height: 380px; max-width: 1000px; }
</style>
