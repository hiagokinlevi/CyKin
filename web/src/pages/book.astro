---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Read a book · CyKin" description="Read a complete public CyKin course book on the site.">
  <section class="book-heading"><div class="shell"><div class="eyebrow">OPEN BOOK · NO ACCOUNT REQUIRED</div><h1 id="book-title">Public course book</h1><p id="book-status" role="status">Loading the current book…</p><a id="book-guide" class="button secondary" href="/learn/">Course lesson guide →</a></div></section>
  <section class="section"><div class="shell book-grid"><aside class="card book-index"><div class="eyebrow">CHAPTERS</div><nav id="book-chapters" aria-label="Book chapters"></nav></aside><article id="book-content" class="card prose book-content"></article></div></section>
  <script>
    import { renderMarkdown, sourceUrlFor } from '../lib/reader';
    import { siteLanguage } from '../lib/i18n';
    const q = new URLSearchParams(location.search);
    const level = q.get('level') || '', area = q.get('area') || '', lang = q.get('lang') || siteLanguage();
    const status = document.getElementById('book-status')!;
    const title = document.getElementById('book-title')!;
    const guide = document.getElementById('book-guide') as HTMLAnchorElement;
    const index = document.getElementById('book-chapters')!;
    const content = document.getElementById('book-content')!;
    if (!/^[a-z0-9-]+$/.test(level) || !/^[a-z0-9-]+$/.test(area) || !/^[a-z]{2}$/.test(lang)) {
      status.textContent = 'Choose a course from the study guide.';
    } else {
      const route = new URLSearchParams({ mode: 'theme', lang, level, area });
      guide.href = '/learn/?' + route;
      try {
        const response = await fetch(`/api/courses/${level}/${area}/${lang}`);
        if (!response.ok) throw new Error('The course guide could not be loaded.');
        const details = await response.json();
        title.textContent = details.course.title;
        document.title = details.course.title + ' · CyKin';
        for (const lesson of details.lessons) {
          const a = document.createElement('a');
          const target = new URLSearchParams(route); target.set('chapter', String(lesson.chapter));
          a.href = '/learn/?' + target;
          a.textContent = `${String(lesson.chapter).padStart(2,'0')} · ${lesson.title}${lesson.published ? '' : ' · planned'}`;
          index.append(a);
        }
        if (!details.book_url) {
          status.textContent = 'This edition has a plan, but its book has not been written yet.';
          const planPath = `levels/${level}/${area}/${lang}/book/PLAN.md`;
          const plan = await fetch('/api/source?' + new URLSearchParams({ path: planPath }));
          if (plan.ok) await renderMarkdown(content, await plan.text(), sourceUrlFor(planPath), lang, 'reference');
        }
        else {
          const book = await fetch(`/api/books/${level}/${area}/${lang}`);
          if (!book.ok) throw new Error('The book is temporarily unavailable.');
          const markdown = await book.text();
          status.textContent = `${details.published_chapters} written chapters · Read here or choose one lesson from the guide.`;
          await renderMarkdown(content, markdown, sourceUrlFor(`levels/${level}/${area}/${lang}/book/MANUSCRIPT.md`), lang, 'book');
          if (location.hash) document.getElementById(decodeURIComponent(location.hash.slice(1)))?.scrollIntoView();
        }
      } catch (error) { status.textContent = String(error); }
    }
  </script>
</BaseLayout>
<style>
  .book-heading { padding: 72px 0 45px; background: var(--bg-2); border-bottom: 1px solid var(--line); }.book-heading h1 { font-size: clamp(2.5rem,5vw,4.5rem); }.book-heading p { color: var(--muted); }.book-heading .button { margin-top: 12px; }
  .book-grid { display: grid; grid-template-columns: 290px minmax(0,1fr); gap: 24px; align-items: start; }.book-index { position: sticky; top: 96px; max-height: calc(100vh - 115px); overflow: auto; padding: 23px; }.book-index nav { display: grid; margin-top: 15px; gap: 8px; }.book-index a { padding: 7px 0; border-bottom: 1px solid var(--line); font-size: .83rem; }.book-index a:hover { color: var(--gold); }.book-content { padding: clamp(25px,4vw,55px); min-height: 440px; }
  @media(max-width:800px){.book-grid{grid-template-columns:1fr}.book-index{position:static;max-height:330px}.book-heading{padding-top:48px}}
</style>
