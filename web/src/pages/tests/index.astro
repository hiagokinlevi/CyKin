---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Test yourself · OpenCyber Academy" description="Timed, chapter-based cybersecurity self-assessments for registered OpenCyber Academy learners." robots="noindex,follow">
  <section class="test-hero"><div class="shell">
    <div class="eyebrow">CHAPTER ASSESSMENTS</div>
    <h1>Test yourself.</h1>
    <p>Choose a language, subject and course level. Each published chapter test has ten multiple-choice questions, with ten seconds for each answer. Reading the books stays free and open; saving test results requires a student sign-in.</p>
    <p class="test-boundary">These are self-assessments. A course-completion certificate is available only after every chapter test is passed with 10/10 and the entire book passes its editorial completion review. The certificate is not an accredited degree.</p>
  </div></section>

  <section class="section"><div class="shell test-shell">
    <div class="test-step"><div class="test-step-heading"><span class="test-step-number">1</span><h2>Choose your language</h2></div><div id="test-languages" class="test-choices" role="group" aria-label="Test language"></div></div>
    <div class="test-step"><div class="test-step-heading"><span class="test-step-number">2</span><h2>Choose a subject</h2></div><div id="test-subjects" class="test-choices subject-choices" role="group" aria-label="Course subject"></div></div>
    <div class="test-step"><div class="test-step-heading"><span class="test-step-number">3</span><h2>Choose a level</h2></div><div id="test-levels" class="test-choices" role="group" aria-label="Course level"></div></div>
    <div class="test-step test-course"><div class="test-step-heading"><span class="test-step-number">4</span><h2>Published chapter tests</h2></div><p id="test-course-status" class="muted" role="status">Select a language, subject and level.</p><div id="test-chapters" class="test-chapters"></div></div>
    <section id="test-player" class="test-player card" hidden aria-live="polite">
      <div class="eyebrow">TEN SECONDS PER QUESTION</div>
      <div class="test-player-head"><h2 id="test-question-number">Question 1 of 10</h2><span id="test-timer" class="test-timer" aria-label="Time remaining">10</span></div>
      <p id="test-prompt" class="test-prompt"></p>
      <form id="test-answer-form"><fieldset id="test-options" class="test-options"><legend class="sr-only">Choose one answer</legend></fieldset><button class="button gold" type="submit" id="test-submit">Submit answer →</button></form>
      <p id="test-feedback-status" class="muted" role="status"></p>
    </section>
    <section id="test-result" class="test-result card" hidden><div class="eyebrow">ATTEMPT COMPLETE</div><h2 id="test-score"></h2><p id="test-result-note"></p><div id="test-explanations"></div><button id="test-retry" type="button" class="button secondary">Try again</button><button id="test-certificate" type="button" class="button gold" hidden>Claim course certificate</button><p id="test-certificate-status" role="status"></p></section>
  </div></section>
  <script>
    import { initChapterTests } from '../../lib/chapter-tests';
    initChapterTests();
  </script>
</BaseLayout>
<style is:global>
  .test-hero{padding:78px 0 62px;background:linear-gradient(125deg,var(--bg-2),var(--bg));border-bottom:1px solid var(--line)}
  .test-hero h1{font-size:clamp(2.8rem,5vw,5rem);margin:14px 0}.test-hero p{max-width:780px;color:var(--muted);font-size:1.06rem;line-height:1.65}
  .test-hero .test-boundary{font-size:.9rem;border-left:3px solid var(--gold);padding-left:16px;margin-top:22px}
  .test-shell{max-width:1080px}.test-step{border-bottom:1px solid var(--line);padding:0 0 30px;margin-bottom:30px}.test-step-heading{display:flex;align-items:center;gap:14px;margin-bottom:18px}.test-step-heading h2{font-size:1.5rem;margin:0}.test-step-number{display:grid;place-items:center;width:32px;height:32px;border:1px solid var(--gold);color:var(--gold);font-size:.9rem}
  .test-choices{display:flex;gap:9px;flex-wrap:wrap}.test-choices button{border:1px solid var(--line);background:var(--surface);color:var(--text);padding:10px 16px;border-radius:3px;font:inherit;cursor:pointer;text-align:left}.test-choices button:hover,.test-choices button[aria-pressed="true"]{border-color:var(--gold);color:var(--gold)}.subject-choices button{max-width:290px}
  .test-chapters{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:12px}.test-chapter{padding:18px;background:var(--surface);border:1px solid var(--line);border-radius:3px}.test-chapter strong{display:block;margin-bottom:7px}.test-best{display:block;color:var(--gold);margin:0 0 9px}.test-best:empty{display:none}.test-chapter a{display:inline-block;margin-right:12px;font-size:.9rem}.test-chapter button{background:none;border:0;padding:0;color:var(--gold);font:inherit;font-size:.9rem;cursor:pointer;text-decoration:underline}
  .test-player,.test-result{padding:28px;margin:28px 0}.test-player[hidden],.test-result[hidden]{display:none}.test-player-head{display:flex;justify-content:space-between;gap:15px;align-items:center}.test-player-head h2{margin:10px 0;font-size:1.5rem}.test-timer{display:grid;place-items:center;min-width:50px;height:50px;border:2px solid var(--gold);border-radius:50%;color:var(--gold);font-variant-numeric:tabular-nums;font-size:1.3rem}.test-timer.low{border-color:#e37061;color:#e37061}.test-prompt{font-size:1.18rem;font-weight:550}.test-options{border:0;padding:0;display:grid;gap:10px;margin:20px 0}.test-option{display:flex;gap:12px;align-items:flex-start;padding:12px;border:1px solid var(--line);cursor:pointer}.test-option:has(input:checked){border-color:var(--gold)}.test-result h2{font-size:1.8rem}.test-explanation{border-top:1px solid var(--line);padding:14px 0}.test-explanation strong{color:var(--gold)}.test-explanation p{margin:6px 0}.test-explanation small{color:var(--muted)}
  @media(max-width:640px){.test-hero{padding:58px 0 45px}.test-step-heading h2{font-size:1.2rem}.test-choices button{flex:1 1 auto}.test-player,.test-result{padding:18px}}
</style>
